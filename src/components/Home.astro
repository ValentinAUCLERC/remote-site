---
import { content, site, measure, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const t = content[Astro.props.lang];
const m = measure;
const n = (s: string) => parseFloat(s.replace(',', '.'));
---
<header class="wrap top">
  <a class="brand" href={t.lang === 'fr' ? '/' : '/en/'}>REMOTE</a>
  <nav>
    <a href="#fonctionnement">{t.nav.how}</a>
    <a href="#installer">{t.nav.install}</a>
    <a href="#depannage">{t.nav.help}</a>
    <a href={t.nav.otherHref} lang={t.lang === 'fr' ? 'en' : 'fr'}>{t.nav.other}</a>
  </nav>
</header>

<main>
  <section class="wrap hero">
    <div>
      <h1>{t.hero.title[0]}<br /><em>{m.total.split(',')[0]} ms</em> {t.hero.title[1]}</h1>
      <p class="lead">{t.hero.lead}</p>
      <div class="cta">
        {site.available
          ? <><a class="btn" href={site.download}>{t.hero.cta}</a><span class="muted">{t.hero.meta} · {site.zipSize}</span></>
          : <span class="btn off" aria-disabled="true">{t.hero.soon}</span>}
      </div>
    </div>
    <figure class="hud" aria-label={t.hud.caption}>
      <div class="hud-t">{t.hud.format}</div>
      <div class="hud-big">{m.total} ms</div>
      <div class="bar" aria-hidden="true">
        <i style={`flex:${n(m.host)};background:var(--blue)`}></i>
        <i style={`flex:${n(m.net)};background:var(--green)`}></i>
        <i style={`flex:${n(m.client)};background:var(--amber)`}></i>
      </div>
      <div class="legend">
        <span style="--c:var(--blue)">{t.hud.host} {m.host}</span>
        <span style="--c:var(--green)">{t.hud.net} {m.net}</span>
        <span style="--c:var(--amber)">{t.hud.client} {m.client}</span>
      </div>
      <svg class="spark" viewBox="0 0 300 38" preserveAspectRatio="none" aria-hidden="true"><polyline fill="none" stroke="var(--blue)" stroke-width="1.5" vector-effect="non-scaling-stroke" points="0,28 20,27 40,29 60,26 80,28 100,27 120,25 140,28 160,8 170,27 190,28 210,26 230,28 250,27 270,29 300,27" /></svg>
      <div class="hud-line">{t.hud.line(m.rtt)}</div>
      <figcaption>{t.hud.caption}</figcaption>
    </figure>
  </section>

  <section class="wrap">
    <dl class="facts">
      {t.facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
    </dl>
  </section>

  <section class="wrap" id="fonctionnement">
    <h2>{t.how.title}</h2>
    <ol class="pipe">
      {t.how.steps.map((s) => <li><b>{s.k}</b><span>{s.v}</span></li>)}
    </ol>
    <div class="split">
      <div>
        <h3>{t.how.pathTitle}</h3>
        <p>{t.how.path}</p>
      </div>
      <div>
        <h3>{t.features.title}</h3>
        <ul class="feat">{t.features.list.map((f) => <li>{f}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="wrap" id="installer">
    <h2>{t.install.title}</h2>
    <ol class="steps">
      {t.install.steps.map((s) => <li><b>{s.k}</b><span>{s.v}</span></li>)}
    </ol>
    <dl class="needs">
      {t.install.needs.map((x) => <div><dt>{x.k}</dt><dd>{x.v}</dd></div>)}
    </dl>
    {site.available && <div class="cta"><a class="btn" href={site.download}>{t.hero.cta}</a><a class="muted" href={site.releases}>{t.footer.releases} →</a></div>}
  </section>

  <section class="wrap" id="depannage">
    <h2>{t.help.title}</h2>
    <div class="faq">
      {t.help.items.map((i) => <details><summary>{i.q}</summary><p>{i.a}</p></details>)}
    </div>
  </section>

  <section class="wrap about">
    <h2>{t.about.title}</h2>
    <p>{t.about.text}</p>
    <p class="muted">{t.about.by} <a href={site.authorUrl}>{site.author}</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
  </section>
</main>

<footer class="wrap foot">
  <span>© {new Date().getFullYear()} {site.author}</span>
  <span>{t.footer.ffmpeg}</span>
  <a href={t.footer.legalHref}>{t.footer.legal}</a>
</footer>

<style>
  .top { display: flex; justify-content: space-between; align-items: center; padding-top: 26px; padding-bottom: 26px; font-size: 13px; color: var(--muted); }
  .brand { color: var(--white); font-weight: 700; letter-spacing: .1em; text-decoration: none; }
  .top nav { display: flex; gap: 22px; }
  .top nav a { text-decoration: none; }
  .top nav a:hover { color: var(--white); }

  .hero { display: grid; grid-template-columns: 1.1fr .9fr; gap: 56px; align-items: center; padding-top: 48px; padding-bottom: 24px; }
  h1 { font: 800 clamp(40px, 6vw, 60px)/1.02 var(--sans); color: #fff; letter-spacing: -.025em; margin: 0; }
  h1 em { font-style: normal; color: var(--green); }
  .lead { margin: 22px 0 0; color: #9aa4af; max-width: 46ch; }
  .cta { margin-top: 30px; display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
  .btn { background: var(--green); color: #06110a; font-weight: 700; padding: 13px 20px; border-radius: 4px; font-size: 14px; text-decoration: none; transition: filter .15s; }
  .btn:hover { filter: brightness(1.1); }
  .btn.off { background: transparent; color: var(--green); border: 1px dashed #2f6b4a; cursor: default; filter: none; }
  .muted { font-size: 12px; color: var(--muted); }

  .hud { margin: 0; background: rgba(20, 24, 29, .92); border: 1px solid #232a32; border-radius: 6px; padding: 18px 20px; font-size: 13px; line-height: 1.75; }
  .hud-t { color: var(--blue); font-weight: 700; }
  .hud-big { font-size: 46px; color: #fff; font-weight: 700; line-height: 1.1; margin: 6px 0 10px; }
  .bar { display: flex; height: 10px; border-radius: 2px; overflow: hidden; gap: 2px; margin: 4px 0 12px; }
  .bar i { display: block; }
  .legend { display: flex; gap: 16px; font-size: 12px; color: var(--muted); flex-wrap: wrap; }
  .legend span::before { content: ''; display: inline-block; width: 8px; height: 8px; margin-right: 6px; background: var(--c); }
  .spark { margin-top: 12px; height: 38px; width: 100%; display: block; }
  .hud-line { color: var(--muted); }
  .hud figcaption { margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line); font-size: 11px; color: #6b7580; }

  .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); margin: 64px 0 0; }
  .facts div { background: var(--bg); padding: 18px; }
  .facts dt { color: #fff; font-size: 22px; font-weight: 700; margin-bottom: 6px; }
  .facts dd { margin: 0; font-size: 12px; color: var(--muted); line-height: 1.5; }

  h2 { font: 700 26px/1.2 var(--sans); color: #fff; margin: 88px 0 22px; letter-spacing: -.01em; }
  h3 { font: 700 15px/1.3 var(--sans); color: var(--white); margin: 0 0 10px; }

  .pipe { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; }
  .pipe li { background: var(--panel); padding: 18px; font-size: 13px; color: #9aa4af; position: relative; }
  .pipe li b { display: block; color: var(--green); margin-bottom: 8px; }
  .pipe li:not(:last-child)::after { content: '→'; position: absolute; right: -9px; top: 16px; color: #3a444f; z-index: 1; }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin-top: 40px; font-size: 14px; color: #9aa4af; }
  .split p { margin: 0; }
  .feat { margin: 0; padding: 0; list-style: none; }
  .feat li { padding: 5px 0 5px 18px; position: relative; border-bottom: 1px solid var(--line); }
  .feat li::before { content: '+'; position: absolute; left: 0; color: var(--green); }

  .steps { list-style: none; counter-reset: s; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; padding: 0; margin: 0; }
  .steps li { counter-increment: s; border-top: 1px solid #2a323b; padding-top: 14px; font-size: 13px; color: #9aa4af; }
  .steps li::before { content: '0' counter(s); color: var(--green); font-weight: 700; display: block; margin-bottom: 6px; }
  .steps b { display: block; color: var(--white); }
  .needs { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 36px; margin: 32px 0 0; font-size: 13px; }
  .needs dt { color: var(--muted); }
  .needs dd { margin: 0; color: var(--text); }

  .faq { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; padding: 14px 0; color: var(--white); font-size: 14px; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--green); }
  details[open] summary::after { content: '−'; }
  details p { margin: 0 0 16px; color: #9aa4af; font-size: 13px; max-width: 75ch; }

  .about p { color: #9aa4af; font-size: 14px; max-width: 72ch; margin: 0 0 12px; }
  .about a { color: var(--green); }

  .foot { display: flex; gap: 24px; justify-content: space-between; flex-wrap: wrap; margin-top: 88px; padding-top: 22px; padding-bottom: 40px; border-top: 1px solid var(--line); font-size: 12px; color: #6b7580; }

  @media (max-width: 860px) {
    .hero, .split { grid-template-columns: 1fr; gap: 36px; }
    .facts, .pipe { grid-template-columns: 1fr 1fr; }
    .pipe li::after { display: none; }
    .steps, .needs { grid-template-columns: 1fr; }
    .top nav a:not(:last-child) { display: none; }
  }
  @media (max-width: 480px) {
    .facts, .pipe { grid-template-columns: 1fr; }
    .wrap { padding: 0 20px; }
  }
</style>
