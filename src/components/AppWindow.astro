---
// La page « Ordinateurs » de l'appli v10 (maquette A, SPEC.md § 2-3), redessinée en HTML/CSS.
// Illustration : role="img" + aria-label ; tailles en em, mise en page pilotée par la
// largeur du conteneur (container queries), donc rien ne déborde sur mobile.
import { app } from '../i18n/content';
interface Props { label: string }
const { label } = Astro.props;
const a = app;
const icon = {
  screen: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  invite: '<circle cx="9" cy="8" r="4"/><path d="M2 21v-1a6 6 0 0 1 11-3M19 14v6M16 17h6"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  sliders: '<path d="M4 6h16M4 12h16M4 18h16"/><circle cx="9" cy="6" r="2" fill="#0e0f11"/><circle cx="15" cy="12" r="2" fill="#0e0f11"/><circle cx="10" cy="18" r="2" fill="#0e0f11"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  updown: '<path d="m7 15 5 5 5-5M7 9l5-5 5 5"/>',
  play: '<path d="M6 4l13 8-13 8z" fill="currentColor"/>',
};
---
<div class="aw" role="img" aria-label={label}>
  <div class="app">
    <div class="title">
      <svg viewBox="0 0 32 32" class="logo"><rect x="5" y="8" width="22" height="14" rx="2" fill="none" stroke="#5df0a0" stroke-width="2.6"/><path d="M12 27h8" stroke="#5df0a0" stroke-width="2.6" stroke-linecap="round"/></svg>
      {a.title}
      <span class="ctl"><i>—</i><i>☐</i><i>✕</i></span>
    </div>
    <div class="body">
      <div class="side">
        {a.nav.map((n, i) => (
          <div class:list={['item', { on: n.on }]}><svg class="i" viewBox="0 0 24 24" set:html={i === 0 ? icon.screen : icon.invite} />{n.label}<span class="n mono">{n.n}</span></div>
        ))}
        <div class="label">{a.navPc}</div>
        <div class="item"><svg class="i" viewBox="0 0 24 24" set:html={icon.shield} />{a.share}</div>
        <div class="item"><svg class="i" viewBox="0 0 24 24" set:html={icon.sliders} />{a.settings}</div>
        <div class="me"><span class="av">{a.me.initial}</span><span class="who">{a.me.name}<small>{a.me.sub}</small></span><svg class="i" viewBox="0 0 24 24" set:html={icon.updown} /></div>
      </div>
      <div class="main">
        <div class="head">
          <div class="h">{a.page}</div>
          <div class="go">
            <div class="field"><svg class="i" viewBox="0 0 24 24" set:html={icon.search} /><span class="ph">{a.search}</span><kbd class="mono">{a.kbd}</kbd></div>
            <span class="btn s"><svg class="i" viewBox="0 0 24 24" set:html={icon.plus} /><span class="lbl">{a.add}</span></span>
          </div>
        </div>
        <div class="sec">{a.mine} <small>{a.mineSub}</small></div>
        <div class="grid">
          {a.pcs.map((p, i) => (
            <div class:list={['card', { hov: i === 0 }]}>
              <div class:list={['shot', `w-${p.wall}`, { off: p.state === 'off' }]}>
                {p.wall === 'win' && <>
                  <span class="win code" style="left:10%;top:9%;width:58%;height:66%"><b></b><u style="width:42%;background:#c678dd"></u><u style="width:64%;background:#61afef"></u><u style="width:30%;background:#98c379"></u><u style="width:54%;background:#5c6370"></u><u style="width:38%;background:#e5c07b"></u></span>
                  <span class="win" style="left:60%;top:30%;width:32%;height:40%"><b></b></span>
                </>}
                {p.wall === 'plain' && <span class="win" style="left:18%;top:16%;width:50%;height:56%"><b></b></span>}
                <span class="taskbar"><i></i><i></i><i></i><i></i></span>
                {i === 0 && <span class="overlay"><span class="btn p"><svg class="i" viewBox="0 0 24 24" set:html={icon.play} />{a.connect}</span></span>}
              </div>
              <div class="meta">
                <div class="t"><div class="name">{p.name}</div><div class="st"><span class:list={['dot', p.state]}></span><span class="ell">{p.st}<span class="when">{p.when}</span></span></div></div>
                <span class="more">•••</span>
              </div>
            </div>
          ))}
        </div>
        <div class="sec">{a.shared} <small>{a.sharedSub}</small></div>
        <div class="rows">
          <div class="row">
            <svg class="i ic" viewBox="0 0 24 24" set:html={icon.screen} />
            <div class="rt"><div>{a.sharedPc.name} <span class="sub">· {a.sharedPc.owner}</span></div><div class="sub ell">{a.sharedPc.sub}</div></div>
            <div class="r"><span class="dot on"></span><span class="btn s sm">{a.connect}</span></div>
          </div>
        </div>
        <div class="sec">{a.local} <small class="ls">{a.localSub}</small></div>
        <div class="rows">
          <div class="row">
            <svg class="i ic" viewBox="0 0 24 24" set:html={icon.screen} />
            <div class="rt"><div>{a.localPc.name}</div><div class="sub mono">{a.localPc.ip}</div></div>
            <div class="r"><span class="btn s sm">{a.pair}</span></div>
          </div>
        </div>
      </div>
    </div>
    <div class="status"><span class="dot on"></span><b>{a.status.label}</b><span class="ell">{a.status.text}</span>
      <span class="r"><span class="mono sid">{a.status.id}</span><span class="mono">{a.status.version}</span></span></div>
  </div>
</div>

<style>
  .aw { container-type: inline-size; }
  .app {
    font-size: 14px; line-height: 1.35; color: var(--t1); background: var(--bg);
    border: 1px solid #2a2b30; border-radius: 10px; overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, .45);
    display: grid; grid-template-rows: auto 1fr auto;
    user-select: none;
  }
  .title { display: flex; align-items: center; gap: .6em; height: 2.6em; padding-left: 1em; background: var(--side); border-bottom: 1px solid var(--line); font-size: .93em; color: var(--t2); }
  .logo { width: 1.15em; height: 1.15em; }
  .ctl { margin-left: auto; display: flex; height: 100%; }
  .ctl i { font-style: normal; width: 3.3em; display: grid; place-items: center; color: var(--t3); }

  .body { display: grid; grid-template-columns: 16.5em 1fr; min-width: 0; }
  .side { background: var(--side); border-right: 1px solid var(--line); padding: 1.15em .85em; display: flex; flex-direction: column; gap: 2px; }
  .item { height: 2.45em; display: flex; align-items: center; gap: .7em; padding: 0 .7em; border-radius: 8px; color: var(--t2); }
  .item.on { background: var(--raised); color: var(--t1); box-shadow: inset 0 0 0 1px var(--line); }
  .item .n { margin-left: auto; font-size: .85em; color: var(--t3); }
  .label { font-size: .86em; color: var(--t3); padding: 1.4em .7em .4em; }
  .me { margin-top: auto; display: flex; align-items: center; gap: .7em; padding: .7em; border-radius: 10px; border: 1px solid var(--line); }
  .me > svg { margin-left: auto; color: var(--t3); }
  .av { width: 2.15em; height: 2.15em; border-radius: 50%; background: #2c3a33; color: var(--acc); display: grid; place-items: center; font-weight: 600; font-size: .93em; flex: none; }
  .who { font-size: .93em; line-height: 1.3; } .who small { display: block; color: var(--t3); font-size: .92em; }

  .main { padding: 1.7em 2em 2em; min-width: 0; }
  .head { display: flex; align-items: center; gap: 1.1em; }
  .h { font-size: 1.57em; font-weight: 500; letter-spacing: -.01em; }
  .go { margin-left: auto; display: flex; gap: .6em; min-width: 0; }
  .field { width: 21em; height: 2.6em; border-radius: 8px; background: var(--card); border: 1px solid var(--line); display: flex; align-items: center; gap: .6em; padding: 0 .85em; color: var(--t3); min-width: 0; }
  .ph { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  kbd { margin-left: auto; font-size: .78em; color: var(--t3); border: 1px solid #34353a; border-bottom-width: 2px; border-radius: 4px; padding: 1px 5px; white-space: nowrap; }
  .btn { height: 2.6em; padding: 0 1.15em; border-radius: 8px; font-weight: 500; display: inline-flex; align-items: center; gap: .55em; white-space: nowrap; }
  .btn.sm { height: 2.3em; }
  .btn.p { background: var(--acc); color: var(--on-acc); }
  .btn.s { background: var(--raised); color: var(--t1); box-shadow: inset 0 0 0 1px #2c2d32; }

  .sec { font-size: .93em; font-weight: 500; color: var(--t2); margin: 2em 0 .6em; display: flex; gap: .6em; align-items: baseline; white-space: nowrap; }
  .head + .sec { margin-top: 1.4em; }
  .sec small { color: var(--t3); font-weight: 400; font-size: 1em; overflow: hidden; text-overflow: ellipsis; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1em; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: .55em; min-width: 0; }
  .card.hov { background: var(--hover); }
  .meta { padding: .85em .4em .4em; display: flex; align-items: flex-start; gap: .7em; }
  .meta .t { flex: 1; min-width: 0; }
  .name { font-size: 1.07em; font-weight: 500; }
  .st { font-size: .9em; color: var(--t3); margin-top: 2px; display: flex; align-items: center; gap: .45em; }
  .ell { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: #4a4c52; flex: none; }
  .dot.on { background: var(--acc); } .dot.busy { background: var(--warn); }
  .more { width: 2em; height: 2em; border-radius: 6px; display: grid; place-items: center; color: var(--t3); font-size: .9em; flex: none; }
  .card.hov .more { background: var(--raised); color: var(--t1); }
  /* t3 n'atteint 4,5:1 que sur bg : sur les fonds plus clairs, t2. */
  .card.hov .st, .item.on .n { color: var(--t2); }

  /* Vignettes : l'image de la dernière session (fonds d'écran factices, comme la maquette). */
  .shot { position: relative; overflow: hidden; border-radius: 6px; aspect-ratio: 16 / 10; display: block; }
  .w-win { background: radial-gradient(120% 90% at 70% 110%, #2d6fd6 0%, #1c3f8f 35%, #0f1d45 70%, #0a1230 100%); }
  .w-dusk { background: linear-gradient(180deg, #2a2236 0%, #6b4a5c 45%, #d08a6a 78%, #f0b585 100%); }
  .w-dusk::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 32%; background: #1f1724; clip-path: polygon(0 60%, 14% 30%, 26% 52%, 40% 18%, 55% 46%, 70% 22%, 84% 50%, 100% 28%, 100% 100%, 0 100%); }
  .w-plain { background: #2b3440; }
  .shot.off { filter: grayscale(1) brightness(.8); }
  .taskbar { position: absolute; left: 0; right: 0; bottom: 0; height: 8%; background: rgba(20, 22, 28, .82); display: flex; justify-content: center; align-items: center; gap: 3%; z-index: 1; }
  .taskbar i { width: 3%; aspect-ratio: 1; border-radius: 2px; background: rgba(255, 255, 255, .55); }
  .taskbar i:nth-child(2) { background: #f2b33d; } .taskbar i:nth-child(3) { background: #4d9cf0; } .taskbar i:nth-child(4) { background: #5fd47a; }
  .win { position: absolute; border-radius: 3px; background: #1d1f24; overflow: hidden; display: block; }
  .win b { display: block; height: 9%; min-height: 3px; background: #2a2d33; }
  .win u { display: block; height: 4%; margin: 3% 0 0 6%; border-radius: 2px; }
  .overlay { position: absolute; inset: 0; background: rgba(8, 9, 10, .45); display: grid; place-items: center; z-index: 2; }

  .rows { background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
  .row { min-height: 3.7em; display: flex; align-items: center; gap: .85em; padding: .5em 1em; }
  .rt { min-width: 0; }
  .sub { color: var(--t3); font-size: .9em; }
  .row .r { margin-left: auto; display: flex; align-items: center; gap: .85em; flex: none; }
  .ic { color: var(--t2); }

  .status { display: flex; align-items: center; gap: .7em; height: 2.3em; padding: 0 1.15em; font-size: .9em; color: var(--t3); border-top: 1px solid var(--line); background: var(--side); min-width: 0; }
  .status b { color: var(--t2); font-weight: 500; flex: none; }
  .status .r { margin-left: auto; display: flex; gap: 1.15em; flex: none; }

  /* Tablette : la barre latérale se replie. */
  @container (max-width: 820px) {
    .body { grid-template-columns: 1fr; }
    .side { display: none; }
  }
  /* Petit écran : deux PC, recherche en icône. */
  @container (max-width: 600px) {
    .app { font-size: 13.5px; }
    .ctl i { width: 2.6em; }
    .main { padding: 1.2em 1em 1.3em; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7em; }
    .card:nth-child(3) { display: none; }
    .field { width: auto; padding: 0 .75em; }
    .field .ph, .field kbd, .btn.s .lbl { display: none; }
    .go .btn.s { padding: 0 .75em; }
    .sec .ls, .sid, .when { display: none; }
    .overlay .btn { padding: 0 .8em; }
  }
  @container (max-width: 380px) {
    .row .dot { display: none; }
    .btn.sm { padding: 0 .8em; }
  }
</style>
